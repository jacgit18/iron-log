# Copy to .env (git-ignored). dbmate and kysely-codegen read it automatically.
DATABASE_URL=postgres://ironlog:ironlog@127.0.0.1:5433/ironlog?sslmode=disable
# Migrations only: skip the schema.sql dump (it needs pg_dump installed).
DBMATE_NO_DUMP_SCHEMA=true
DBMATE_MIGRATIONS_DIR=db/migrations
# The oldest app build allowed to sync: the unix time (seconds) of its commit. An older app gets 426 and stops sending.
# Find one with: git log -1 --format=%ct <commit>. Leave unset for no gate.
# MIN_CLIENT_VERSION=

# Sign-in with Google (ADR 004). All of these are needed; if any is missing sign-in stays off and the server log says which.
# BASE_URL is this API's own address (an origin, https in production). In the Google console, add
#   <BASE_URL>/api/auth/callback/google
# as an authorized redirect URI. Never commit real values.
# BASE_URL=http://localhost:3002
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_SECRET=   (at least 32 random characters: openssl rand -base64 32)
# Seal names and emails in the database (ADR 046). Optional: unset, they are stored as before. 32 random bytes, base64:
#   openssl rand -base64 32
# Back it up outside the database: without it sealed names and emails cannot be read. Never change it once rows are sealed.
# PII_ENCRYPTION_KEY=
# After `npm run encrypt:users -- --apply` has sealed every old row, set this so sign-in stops matching plaintext emails.
# PII_PLAINTEXT_DONE=true
# Sign-in with an emailed code (ADR 042). Optional: unset, the email option does not exist. Get a key at resend.com.
# With no EMAIL_FROM the sender is Resend's test address, which only delivers to the email on your Resend account.
# After you verify a domain in Resend, set EMAIL_FROM to e.g. "Loadbearer <login@yourdomain.com>".
# RESEND_API_KEY=
# EMAIL_FROM=
# Until set to true, only the ADMIN_EMAILS addresses can use the emailed code (checked on the server). Set it when a domain is verified.
# EMAIL_CODE_OPEN=true
# Tests only: turns on email and password sign-in so automated tests can sign in. The server refuses to start with it
# unless NODE_ENV is development or test.
# AUTH_TEST_SIGNIN=true

# Which database role the API connects as (migration 009, row-level security). DATABASE_URL is the owner that runs migrations;
# the API should run as the restricted role ironlog_app, so row-level security applies to it:
#   1. once per database, as the owner:  ALTER ROLE ironlog_app LOGIN PASSWORD '<a password you choose and keep>';
#   2. APP_DATABASE_URL=postgres://ironlog_app:<password>@<same host and database as DATABASE_URL>
# The API prefers APP_DATABASE_URL and falls back to DATABASE_URL for local development only. Outside development and test it
# refuses to start if it is connected as a superuser, a role with BYPASSRLS, or the owner of the tables.
# APP_DATABASE_URL=

# Who sees admin-only features (src/features.ts): comma-separated Google emails; a development user is `dev:<name>`. Unset: nobody.
# ADMIN_EMAILS=you@example.com,dev:owner

# Stripe billing (ADR 065), test mode first. Off unless all four are set. Use test keys (sk_test_...); a live key (sk_live_...) is refused
# unless BILLING_LIVE=1. Prices are made in the Stripe dashboard (one monthly, one yearly); the webhook secret comes from
# `stripe listen` locally or the dashboard endpoint (POST /api/stripe/webhook, events: checkout.session.completed and customer.subscription.*).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_YEARLY=
# BILLING_LIVE=1

# Android app (Trusted Web Activity). /.well-known/assetlinks.json is built from these on each request (server/assetLinks.ts); unset gives a 404.
# The package name is permanent; the fingerprint is the SHA-256 of Play App Signing key (Play Console, App integrity). Comma-separate several.
# ANDROID_PACKAGE_NAME=
# ANDROID_SHA256_CERT_FINGERPRINTS=
