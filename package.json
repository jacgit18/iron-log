{
  "name": "iron-log",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "lint": "oxlint",
    "typecheck": "tsc && tsc -p server",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "node tools/screenshots.mjs",
    "db:start": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:migrate": "dbmate up && npm run db:types",
    "db:rollback": "dbmate down && npm run db:types",
    "db:types": "kysely-codegen --dialect postgres --date-parser string --exclude-pattern schema_migrations --out-file server/db/types.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@neon/env": "^1.5.1",
    "express": "^5.2.1",
    "kysely": "^0.28.17",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@neon/config": "^1.8.4",
    "@playwright/test": "^1.63.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dbmate": "^2.36.0",
    "kysely-codegen": "^0.20.0",
    "oxlint": "^1.81.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
