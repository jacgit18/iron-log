{
  "name": "iron-log",
  "private": true,
  "version": "1.0.0-alpha.1",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "qa:seed": "tsx scripts/qa-seed.mjs",
    "seed:test-user": "tsx server/scripts/seedTestUserCli.ts",
    "reset:accounts": "tsx scripts/reset-accounts.mjs",
    "beta:to-free": "tsx scripts/beta-to-free.mjs",
    "keep:injury-prevention": "tsx scripts/keep-injury-prevention.mjs",
    "encrypt:users": "tsx scripts/encrypt-users.mjs",
    "delete:user": "tsx scripts/delete-user.mjs",
    "find:user": "tsx scripts/find-user.mjs",
    "list:users": "tsx scripts/list-users.mjs",
    "grocery:shares": "tsx scripts/grocery-shares.mjs",
    "own:exercises": "tsx scripts/own-exercises.mjs",
    "catalog:import": "tsx scripts/catalog-import.mjs",
    "prod:db": "scripts/prod-db.sh",
    "build:server": "node scripts/build-server.mjs",
    "dev:server": "NODE_ENV=development tsx watch server/index.ts",
    "build": "vite build",
    "lint": "oxlint && node scripts/format-css.mjs --check && node scripts/check-css-tokens.mjs && npm run docs:toc",
    "docs:toc": "node scripts/doc-toc.mjs --check --style=md README.md SETUP.md",
    "docs:toc:write": "node scripts/doc-toc.mjs --style=md README.md SETUP.md",
    "format:css": "node scripts/format-css.mjs",
    "typecheck": "tsc && tsc -p tsconfig.sw.json && tsc -p server",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "sh scripts/coverage.sh",
    "e2e": "playwright test",
    "check": "node scripts/check.mjs",
    "e2e:sync": "node scripts/e2e-sync.mjs",
    "screenshots": "node tools/screenshots.mjs",
    "db:start": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:migrate": "dbmate up && npm run db:types",
    "db:rollback": "dbmate down && npm run db:types",
    "db:check": "node scripts/check-migrations.mjs",
    "db:types": "kysely-codegen --dialect postgres --date-parser string --exclude-pattern '{*schema_migrations,auth.*}' --out-file server/db/types.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.10",
    "@better-auth/kysely-adapter": "1.7.10",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@neon/env": "^1.6.3",
    "better-auth": "1.7.10",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.1",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.0.0",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@neon/config": "^1.8.4",
    "@playwright/test": "^1.64.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "dbmate": "^2.37.0",
    "esbuild": "^0.28.2",
    "kysely-codegen": "^0.20.0",
    "oxlint": "^1.88.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "postcss": "8.5.31",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
