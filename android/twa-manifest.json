{
  "packageId": "app.loadbearer",
  "host": "loadbearer.app",
  "name": "Loadbearer",
  "launcherName": "Loadbearer",
  "display": "standalone",
  "themeColor": "#1E2326",
  "themeColorDark": "#000000",
  "navigationColor": "#1E2326",
  "navigationColorDark": "#000000",
  "navigationDividerColor": "#000000",
  "navigationDividerColorDark": "#000000",
  "backgroundColor": "#1E2326",
  "enableNotifications": true,
  "startUrl": "/",
  "iconUrl": "https://loadbearer.app/icons/icon-512.png",
  "maskableIconUrl": "https://loadbearer.app/icons/maskable-512.png",
  "splashScreenFadeOutDuration": 300,
  "signingKey": {
    "path": "./android.keystore",
    "alias": "android"
  },
  "appVersionName": "5",
  "appVersionCode": 5,
  "shortcuts": [
    {
      "name": "Today's workout",
      "shortName": "Today",
      "url": "https://loadbearer.app/?open=board",
      "chosenIconUrl": "https://loadbearer.app/shortcut-icons/today.png"
    },
    {
      "name": "Daily log",
      "shortName": "Daily",
      "url": "https://loadbearer.app/?open=daily",
      "chosenIconUrl": "https://loadbearer.app/shortcut-icons/daily.png"
    },
    {
      "name": "Progress",
      "shortName": "Progress",
      "url": "https://loadbearer.app/?open=progress",
      "chosenIconUrl": "https://loadbearer.app/shortcut-icons/progress.png"
    },
    {
      "name": "Nutrition",
      "shortName": "Nutrition",
      "url": "https://loadbearer.app/#/daily/nutrition",
      "chosenIconUrl": "https://loadbearer.app/shortcut-icons/nutrition.png"
    }
  ],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://loadbearer.app/manifest.webmanifest",
  "fallbackType": "customtabs",
  "features": {},
  "alphaDependencies": {
    "enabled": false
  },
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "shareTarget": {
    "action": "https://loadbearer.app/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  },
  "fullScopeUrl": "https://loadbearer.app/",
  "minSdkVersion": 24,
  "orientation": "default",
  "fingerprints": [],
  "additionalTrustedOrigins": [],
  "retainedBundles": [],
  "protocolHandlers": [],
  "fileHandlers": [],
  "launchHandlerClientMode": "",
  "displayOverride": [],
  "appVersion": "5"
}