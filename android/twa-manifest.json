  "splashScreenFadeOutDuration": 300,
  "signingKey": {
    "path": "./android.keystore",
    "alias": "android"
  },
  "appVersionName": "2",
  "appVersionCode": 2,
  "shortcuts": [
    {
      "name": "Today's workout",
      "shortName": "Today",
      "url": "https://loadbearer.app/?open=board",
      "chosenIconUrl": "https://loadbearer.app/icons/icon-192.png"
    },
    {
      "name": "Daily log",
      "shortName": "Daily",
      "url": "https://loadbearer.app/?open=daily",
      "chosenIconUrl": "https://loadbearer.app/icons/icon-192.png"
    }
  ],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://loadbearer.app/manifest.webmanifest",
  "fallbackType": "customtabs",
  "features": {},
  "alphaDependencies": {
    "enabled": false
  },
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "fullScopeUrl": "https://loadbearer.app/",
  "minSdkVersion": 24,
  "orientation": "default",
  "fingerprints": [],
  "additionalTrustedOrigins": [],
  "retainedBundles": [],
  "protocolHandlers": [],
