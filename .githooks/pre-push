#!/bin/sh
# Runs the checks that fit what this branch changed against origin/main (scripts/check.mjs) before a push, so CI does not find the failure first.
# Docs-only changes run nothing. Skip once with SKIP_CHECK=1 git push, or git push --no-verify.
[ -n "$SKIP_CHECK" ] && exit 0
# A push that only deletes branches has nothing to check; deletes mixed with real refs still run the check.
pushing=""
while read -r _ local_sha _ _; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] || pushing=1
done
[ -n "$pushing" ] || exit 0
exec npm run check
