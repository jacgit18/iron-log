{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "ignorePatterns": [
    "dist"
  ],
  "overrides": [
    {
      "files": [
        "scripts/**/*.mjs"
      ],
      "env": {
        "node": true
      },
      "rules": {
        "no-undef": "error"
      }
    },
    {
      "files": [
        "server/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/components/**",
                  "**/store/**",
                  "**/hooks/**",
                  "**/lib/**"
                ],
                "message": "server/ may import only from src/shared/ (ADR 015)."
              }
            ]
          }
        ]
      }
    }
  ]
}
